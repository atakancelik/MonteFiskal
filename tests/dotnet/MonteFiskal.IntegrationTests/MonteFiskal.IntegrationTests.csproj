  <ItemGroup>
    <ProjectReference Include="../../../src/dotnet/MonteFiskal/MonteFiskal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
