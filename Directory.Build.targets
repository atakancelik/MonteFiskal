<Project>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(RepoRoot)assets/nuget/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)src/dotnet/README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
